# =============================================================================
# .env for populate_corrigendum.py and populate_withheld.py
# Migration scripts: PostgreSQL (swdjk) <-- SQL Server (jkPensionApril30)
# =============================================================================

# ---------------------------------------------------------------
# PostgreSQL (swdjk) -- target: corrigendum & withheld_applications
# Matches appsettings.json DefaultConnection:
#   Host=localhost;Port=5432;Database=swdjk;Username=postgres;Password=1234;...
# ---------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=swdjk
PGUSER=postgres
PGPASSWORD=1234

# ---------------------------------------------------------------
# Microsoft SQL Server -- source: jkSWdeliveredMay30 + UpdateHistory
# SQL Server 2022 Developer (Docker container 3bbd08314dcd)
# ---------------------------------------------------------------
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=jkPensionApril30
MSSQL_USER=sa
# Set the actual SQL Server SA password here:
MSSQL_PASSWORD=U$m1e$k@

# ---------------------------------------------------------------
# Optional overrides used by the scripts (uncomment to enable)
# ---------------------------------------------------------------
# FINANCIAL_YEAR=2025-26          # FY key for corrigendum counter, format YYYY-YY
# TRUNCATE_TABLES=true            # TRUNCATE targets before insert
# HISTORY_BATCH_SIZE=1000         # UpdateHistory fetch batch size

# ---------------------------------------------------------------
# Legacy React entry (original .env content, kept)
# ---------------------------------------------------------------
REACT_APP_BASE_URL='http://localhost:5000/'